# Production Environment Variables для Frontend
# Скопируйте этот файл в .env и заполните значения

# API URL (без слеша в конце)
VITE_API_URL=https://snee.companykd.world/api

# Название приложения
VITE_APP_TITLE=СНЭЭ Graf

# Версия
VITE_APP_VERSION=1.0.0

# Режим окружения
VITE_MODE=production

# Google Analytics ID (опционально)
# VITE_GA_ID=UA-XXXXXXXXX-X

# Sentry DSN для отслеживания ошибок (опционально)
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Дополнительные настройки (опционально)
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_DEBUG=false

