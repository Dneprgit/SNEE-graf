# Production Environment Variables для Backend
# Скопируйте этот файл в .env и заполните значения

# Окружение (development/production)
ENVIRONMENT=production

# API настройки
API_TITLE=SNEE Graf API
API_VERSION=1.0.0
API_DESCRIPTION=API для расчета диспетчерского графика СНЭЭ

# CORS настройки (разрешенные origins)
# Для продакшена укажите ваш домен
ALLOWED_ORIGINS=https://so-spes.ru,https://www.so-spes.ru

# Лимиты
MAX_UPLOAD_SIZE=10485760  # 10MB в байтах

# Логирование
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Workers (для Uvicorn в production)
WORKERS=2

# Таймауты (в секундах)
REQUEST_TIMEOUT=60

# Дополнительные настройки безопасности (опционально)
# SECRET_KEY=your-secret-key-here
# ACCESS_TOKEN_EXPIRE_MINUTES=30

