# Backend Configuration
HOST=0.0.0.0
PORT=8002
DEBUG=True

# CORS Settings (для продакшена указать конкретный домен)
ALLOWED_ORIGINS=http://localhost:3002,http://localhost:5173

# API Settings
API_PREFIX=/api/v1

# HTML tasks catalog
# Локально можно не задавать: будет использована папка web/frontend/html_task
HTML_TASKS_DIR=/opt/snee-graf/html_task

# NotebookLM FAQ
# ID заранее подготовленного блокнота с материалами по подаче исходных данных
NOTEBOOKLM_NOTEBOOK_ID=your-notebook-id
# JSON авторизации из ~/.notebooklm/profiles/default/storage_state.json
NOTEBOOKLM_AUTH_JSON={"cookies":[]}

# QP / HiGHS Settings
ENABLE_QP_DEBUG=false
QP_HIGHS_ALPHA_D=1.0

