# Production Dockerfile для Frontend - Multi-stage build

# Stage 1: Build
FROM node:18-alpine AS builder

WORKDIR /app

# Копируем package файлы
COPY frontend/package*.json ./

# Устанавливаем зависимости (включая devDependencies для сборки)
RUN npm ci

# Копируем исходники
COPY frontend/ .

# Собираем production build
RUN npm run build

# Stage 2: Production с Nginx
FROM nginx:alpine

# Копируем собранные файлы
COPY --from=builder /app/dist /usr/share/nginx/html

# Создаем конфигурацию nginx с поддержкой проксирования API
RUN echo 'server { \
    listen 80; \
    server_name localhost; \
    root /usr/share/nginx/html; \
    index index.html; \
    \
    # Проксируем API запросы на backend \
    location /api { \
        # Для docker-compose используем имя сервиса \
        # Для отдельных docker run используем host.docker.internal \
        # На сервере внешний nginx переопределит это \
        set $backend_host "backend:8002"; \
        proxy_pass http://$backend_host; \
        proxy_http_version 1.1; \
        proxy_set_header Upgrade $http_upgrade; \
        proxy_set_header Connection "upgrade"; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; \
        proxy_set_header X-Forwarded-Proto $scheme; \
        proxy_cache_bypass $http_upgrade; \
        \
        # Таймауты для длительных запросов \
        proxy_connect_timeout 60s; \
        proxy_send_timeout 60s; \
        proxy_read_timeout 60s; \
        \
        # Если backend недоступен, не падаем сразу \
        proxy_intercept_errors off; \
    } \
    \
    # Frontend SPA routing \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
    \
    # Кеширование статики \
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ { \
        expires 1y; \
        add_header Cache-Control "public, immutable"; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]