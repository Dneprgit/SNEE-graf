# Пример файла конфигурации
# Скопируйте этот файл в .env и заполните значения

# ====================
# Desktop Version (PyQt6)
# ====================

# Настройки по умолчанию для СНЭЭ
DEFAULT_INVERTER_POWER=500
DEFAULT_BATTERY_CAPACITY=2000
DEFAULT_EFFICIENCY=0.95

# Настройки интерфейса
WINDOW_WIDTH=1400
WINDOW_HEIGHT=900

